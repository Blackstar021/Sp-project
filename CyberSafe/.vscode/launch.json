{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CyberSafe: Run App",
            "type": "python",
            "request": "launch",
            "module": "run",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}